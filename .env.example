# Server
SERVER_PORT=8080

# PostgreSQL (R2DBC + Flyway)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=private_chat
DB_USER=private_chat
DB_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222

# JWT (сгенерировать свой секрет, минимум 32 символа)
JWT_SECRET=change-me-to-random-256-bit-string-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
