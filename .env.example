# Server
SERVER_PORT=8080

# PostgreSQL (R2DBC + Flyway)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=private_chat
DB_USER=private_chat
DB_PASSWORD=your_password

# R2DBC connection pool (primary / writes)
# С профилем config/postgresql/private-chat-light.conf: max_connections=150 → pool ≤ 110
R2DBC_POOL_INITIAL_SIZE=10
R2DBC_POOL_MAX_SIZE=110
R2DBC_POOL_MAX_IDLE_TIME=30m
R2DBC_POOL_MAX_ACQUIRE_TIME=5s
R2DBC_POOL_MAX_CREATE_TIME=5s

# PostgreSQL read replica (optional — GET /messages)
DB_READ_REPLICA_ENABLED=false
DB_READ_REPLICA_HOST=
DB_READ_REPLICA_PORT=5432
DB_READ_REPLICA_NAME=
DB_READ_REPLICA_USER=
DB_READ_REPLICA_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_POOL_MAX_ACTIVE=32
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=4

# NATS
NATS_URL=nats://localhost:4222

# JWT (сгенерировать свой секрет, минимум 32 символа)
JWT_SECRET=change-me-to-random-256-bit-string-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ACCESS_TOKEN_CACHE_ENABLED=true
JWT_ACCESS_TOKEN_CACHE_MAX_SIZE=10000

# Logging: add profile `json` for structured JSON logs (logstash encoder)
# SPRING_PROFILES_ACTIVE=json

# Rate limits (raise for load tests, e.g. MESSAGE_RATE_LIMIT=200000)
# MESSAGE_RATE_LIMIT=30
# Direct message above threshold uses INCR+EXPIRE instead of sliding-window ZSET (default 1000)
# MESSAGE_RATE_LIMIT_FIXED_WINDOW_THRESHOLD=1000
